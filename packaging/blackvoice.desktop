[Desktop Entry]
Type=Application
Version=1.0
Name=Black Voice
GenericName=Voice Assistant
Comment=Offline-first voice assistant for Linux — a Rudra Labs product
Exec=@BIN@
TryExec=@BIN@
Icon=blackvoice
Terminal=false
Categories=Utility;Accessibility;AudioVideo;
Keywords=voice;assistant;speech;recognition;
StartupNotify=false
# Matches the WM_CLASS Qt sets from setDesktopFileName, so the dock can pair
# the running window with this entry and show the right icon.
StartupWMClass=blackvoice
X-GNOME-UsesNotifications=true

[Desktop Action Listen]
Name=Listen now
Exec=@BIN@ run

[Desktop Action Text]
Name=Type a command
Exec=@BIN@ text

[Desktop Action Doctor]
Name=Check installation
Exec=@BIN@ doctor
