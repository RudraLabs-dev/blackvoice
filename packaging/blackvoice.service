[Unit]
Description=Black Voice — offline-first voice assistant (a Rudra Labs product)
Documentation=https://github.com/RudraLabs-dev/blackvoice
# The tray icon needs a running graphical session.
After=graphical-session.target sound.target
PartOf=graphical-session.target
# Guards Restart=always below: if the process is somehow exiting
# immediately every time (a corrupt config, a missing dependency), give up
# after this many restarts in this window instead of spinning forever, and
# leave a clean "Failed with result 'start-limit-hit'" for `systemctl
# --user status` to show rather than an endless respawn loop.
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
ExecStart=@BIN@ run
# Not on-failure: confirmed live, this process can exit cleanly (code=0,
# "Consumed ... CPU time", no crash trace) from causes that have nothing to
# do with a bug in it - a "Quit" click, or a screen lock/unlock cycle on a
# corporate-managed machine tearing down and rebuilding the session's D-Bus
# services mid-cycle. on-failure only restarts a non-zero exit or a signal,
# so neither case ever brought the assistant back on its own; whoever
# noticed had to run `systemctl --user start blackvoice` by hand. always
# restarts regardless of how the process ended, which is what "the
# assistant should just be running" actually means for something meant to
# sit in the tray all day - StartLimitBurst above is what still stops a
# process that is failing at startup itself from restarting forever.
Restart=always
RestartSec=5
# Give PulseAudio/PipeWire a moment after login before grabbing the mic.
ExecStartPre=/bin/sleep 3

# Any BLACKVOICE_<SECTION>_<KEY> variable overrides the config file, e.g.
#   Environment=BLACKVOICE_SPEECH_MODE=offline
#   Environment=BLACKVOICE_AI_PROVIDER=none
Environment=PYTHONUNBUFFERED=1

# Modest hardening: the assistant only ever needs the user's own files.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# "read-write" is not a real ProtectHome= value - systemd's own choices are a
# bare yes/no, "read-only" or "tmpfs" - so this was silently ignored on every
# machine that ran it (confirmed live: `systemd[...]: .../blackvoice.service:
# Failed to parse ProtectHome=read-write, ignoring`), leaving ProtectHome at
# its default of "no". Written out as that same "no" explicitly rather than
# tightened to "read-only": this app writes its config, models, voices and
# log under $HOME (see config.py's CONFIG_DIR/DATA_DIR/CACHE_DIR), and
# "read-only" blocks writes to the *running user's own* home too, not just
# other users' - it would need an explicit ReadWritePaths= allowlist of every
# one of those directories to avoid breaking exactly what this line is
# supposed to leave alone, and that needs testing against a real install
# before shipping it, not a guess alongside an unrelated bugfix release.
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
